# ── PayPal (sandbox)
PAYPAL_ENV=sandbox            # sandbox | live | mock (offline simulator; also used automatically when no credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=            # from the webhook you create on the app (needed for signature verification)
PAYER_EMAIL=                  # sandbox PERSONAL account email (Week 0 script + demo client email)

# ── GitHub
GITHUB_TOKEN=                 # fine-grained, read-only public repos (public-repo polling; raises rate limit)
GITHUB_WEBHOOK_SECRET=        # GitHub App / repo webhook secret → /api/webhooks/github
GITHUB_OAUTH_CLIENT_ID=       # GitHub login (optional — demo mode works without it)
GITHUB_OAUTH_CLIENT_SECRET=

# ── AI
GEMINI_API_KEY=               # optional — without it, labelled offline heuristics/templates are used
# GEMINI_MODEL=gemini-flash-latest

# ── App
DATABASE_URL=postgres://localhost:5432/proofbill
APP_URL=http://localhost:3000
SESSION_SECRET=               # openssl rand -hex 32
FREELANCER_NAME=              # shown to clients; defaults to your GitHub name
DEMO_REPO=                    # owner/repo used by the seeded demo workspace
DEMO_MODE=on                  # "off" disables the one-click demo login
AG_GRID_LICENSE_KEY=          # optional — trial watermark without it
CRON_SECRET=                  # free hosting only: protects /api/cron/{tick,collections} (openssl rand -hex 32)
