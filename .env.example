GITHUB_APP_PRIVATE_KEY=       # Week 2
GITHUB_WEBHOOK_SECRET=        # Week 2
GITHUB_OAUTH_CLIENT_ID=       # Week 1 login
GITHUB_OAUTH_CLIENT_SECRET=

# ── AI
ANTHROPIC_API_KEY=

# ── App
DATABASE_URL=postgres://localhost:5432/proofbill
APP_URL=http://localhost:3000
