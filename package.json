{
  "name": "proofbill",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter worker dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @proofbill/db migrate",
    "db:generate": "pnpm --filter @proofbill/db generate",
    "db:seed": "pnpm --filter @proofbill/services seed",
    "start:web": "pnpm --filter @proofbill/db migrate && pnpm --filter web start"
  }
}
